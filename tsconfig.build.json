{
  // Emit config: `npm run build` → dist/ (.js + .d.ts + maps).
  // Only src/ is compiled — the harness, the growth tool and the demos are
  // repo furniture, not published surface.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["scripts/**/*", "examples/**/*", "dist/**/*"]
}
